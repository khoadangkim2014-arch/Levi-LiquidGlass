<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Top navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:translationZ="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_back_button"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_arrow_down"
                    android:rotation="90"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/nav_logo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_leaf_logo" />

                <TextView
                    android:id="@+id/nav_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/app_name"
                    android:textColor="#8BC34A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/nav_news_container"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/news_title"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/nav_news_button"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/news_title"
                        android:src="@drawable/ic_nav_news"
                        app:tint="@color/text_secondary" />

                    <View
                        android:id="@+id/nav_news_badge"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_news_unread_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <Button
                    android:id="@+id/nav_sign_in_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:background="@android:color/transparent"
                    android:text="@string/sign_in"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/nav_account_avatar_container"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:visibility="gone">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/nav_account_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/xbox_avatar"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_minecraft_cube" />

                    <ProgressBar
                        android:id="@+id/nav_avatar_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>

        </FrameLayout>

        <View
            android:id="@+id/nav_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <!-- iOS 26-style floating liquid glass tab bar at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- Liquid glass tab bar container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_liquid_glass_tab"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="8dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_tab_launch_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_launch"
                    android:alpha="1.0"
                    android:background="@android:color/transparent" />

                <View
                    android:id="@+id/nav_tab_launch_indicator"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp"
                    android:background="@color/primary"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_tab_instances_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_instances"
                    android:alpha="0.5"
                    android:background="@android:color/transparent" />

                <View
                    android:id="@+id/nav_tab_instances_indicator"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_tab_about_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_about"
                    android:alpha="0.5"
                    android:background="@android:color/transparent" />

                <View
                    android:id="@+id/nav_tab_about_indicator"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/nav_tab_settings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_settings"
                    android:alpha="0.5"
                    android:background="@android:color/transparent" />

                <View
                    android:id="@+id/nav_tab_settings_indicator"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
