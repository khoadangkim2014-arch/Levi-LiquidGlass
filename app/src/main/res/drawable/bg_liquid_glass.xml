<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background blur effect -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Subtle gradient for glass effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#15FFFFFF"
                android:angle="135" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Top highlight -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- Bottom shadow -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
