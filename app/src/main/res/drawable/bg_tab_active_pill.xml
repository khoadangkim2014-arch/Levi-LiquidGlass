<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active tab pill indicator -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="1dp" android:right="1dp" android:height="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#50FFFFFF" />
        </shape>
    </item>
</layer-list>
