<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark base for contrast against white cards -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Frosted glass layer -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Top half shimmer -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Top highlight line -->
    <item android:top="0dp" android:left="4dp" android:right="4dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#AAFFFFFF" />
        </shape>
    </item>
    <!-- Outer stroke for definition -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#60FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>