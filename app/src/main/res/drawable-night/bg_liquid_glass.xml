<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark frosted glass base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC1A1A1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Top highlight streak -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Top border highlight -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
    <!-- Left border highlight -->
    <item android:top="0dp" android:left="0dp" android:bottom="0dp" android:width="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#25FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="0dp"
                android:bottomLeftRadius="24dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
