<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark frosted pill base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0141414" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Top shimmer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Top highlight line -->
    <item android:top="0dp" android:left="4dp" android:right="4dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Outer stroke -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#30FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
